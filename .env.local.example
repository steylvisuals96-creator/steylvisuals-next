# Kopieer dit bestand naar .env.local en vul je echte upload-token in.
# .env.local staat in .gitignore en komt dus nooit in git of in de chat terecht.

# Het Bearer-token van de upload-worker (zelfde code als waarmee je inlogt op /admin).
SV_UPLOAD_TOKEN=

# Optioneel: overschrijf de worker-URL (standaard de steylvisuals-upload worker).
# SV_WORKER_URL=https://steylvisuals-upload.steylvisuals96.workers.dev
